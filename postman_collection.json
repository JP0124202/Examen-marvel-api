{
  "info": {
    "name": "Marvel API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{ \"nombre\": \"Usuario\", \"email\": \"user@example.com\", \"password\": \"12345678\", \"rol\": \"CONSULTA\" }" },
        "url": { "raw": "http://localhost:3000/api/auth/register", "host": ["http://localhost:3000"], "path": ["api","auth","register"] }
      }
    },
    {
      "name": "Auth - login",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"email\": \"admin@marvel.com\", \"password\": \"12345678\" }" },
        "url": { "raw": "http://localhost:3000/api/auth/login", "host": ["http://localhost:3000"], "path": ["api","auth","login"] }
      }
    },
    { "name": "Auth - me", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw":"http://localhost:3000/api/auth/me","host":["http://localhost:3000"],"path":["api","auth","me"] } } },

    { "name": "Heroes - list", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw":"http://localhost:3000/api/heroes","host":["http://localhost:3000"],"path":["api","heroes"] } } },
    { "name": "Missions - list", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": {"raw":"http://localhost:3000/api/misiones","host":["http://localhost:3000"],"path":["api","misiones"] } } }
  ]
}
